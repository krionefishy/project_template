# ============================================================
# Environment variables for Docker Compose and production
# Copy to .env and fill in values — NEVER commit .env to git
# ============================================================

# --- PostgreSQL ---
DB_NAME=app_db            # CHANGE
DB_USER=app               # CHANGE
DB_PASSWORD=secret        # CHANGE: use strong password in production

# --- Redis ---
REDIS_PASSWORD=           # CHANGE: set in production

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- S3 (Yandex Cloud / Cloud.ru / AWS) ---
S3_ENDPOINT_URL=https://storage.yandexcloud.net  # CHANGE
S3_KEY_ID=                 # CHANGE
S3_SECRET_KEY=             # CHANGE
S3_BUCKET_NAME=app-bucket  # CHANGE
S3_REGION=ru-central-1
S3_TENANT_ID=              # CHANGE: Yandex Cloud / Cloud.ru tenant id (leave empty for AWS)

# --- JWT ---
JWT_SECRET=change-me-in-production  # CHANGE: openssl rand -hex 32

# --- Application ---
CONFIG_PATH=/app/backend/shared/settings/config.prod.yaml

# --- Nginx / Domains ---
DOMAIN=example.com  # CHANGE: your domain
