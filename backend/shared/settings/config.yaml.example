app:
  host: "0.0.0.0"
  port: 8000
  workers: 1
  log_level: "INFO"
  service_name: "my-service"
  docs_enabled: true

database:
  url: "postgresql+asyncpg://user:password@localhost:5432/app_db"
  echo: false

redis:
  host: "localhost"
  port: 6379
  password: null
  db: 0

kafka:
  bootstrap_servers: "localhost:9092"
  consumer_group: "app-group"
  max_request_size: 10485760

s3:
  endpoint_url: "https://storage.yandexcloud.net"
  key_id: ""
  secret_key: ""
  bucket_name: "app-bucket"
  region: "ru-central-1"
  tenant_id: ""
  verify: true

jwt:
  secret_key: "change-me-in-production"
  algorithm: "HS256"
  access_token_expire_minutes: 15
  refresh_token_expire_days: 30
  rsa_private_key_pem: null

rsa:
  enabled: true
  private_key_path: "keys/private.pem"
