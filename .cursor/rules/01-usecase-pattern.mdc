# UseCase Pattern

## Required Structure

```python
class CreateOrderUseCase:
    # Constants as class attributes — never hardcode in execute()
    ALLOWED_ROLES: frozenset[str] = frozenset({"admin", "manager"})
    ALLOWED_CONTENT_TYPES: frozenset[str] = frozenset({"application/pdf", "image/jpeg"})
    MAX_FILE_SIZE: int = 50 * 1024 * 1024  # 50 MB

    def __init__(self, session: AsyncSession, kafka_producer: KafkaProducerWrapper) -> None:
        self.session = session
        self.kafka_producer = kafka_producer

    async def execute(
        self,
        request: CreateOrderRequest,
        ctx: AuthContext,
    ) -> OrderDTO:
        # 1. Authorization — raise domain exception
        if ctx.role not in self.ALLOWED_ROLES:
            raise OrderForbiddenError(f"Role {ctx.role!r} cannot create orders")

        # 2. Business logic + DB
        # 3. Kafka publish for external ops
        # 4. Return DTO (never None — raise exceptions instead)
```

## Logging

Log anything that is not found, failed, or skipped:

```python
import logging
logger = logging.getLogger(__name__)

# Entity not found
result = await self.session.execute(select(OrderModel).where(OrderModel.id == order_id))
order = result.scalar_one_or_none()
if order is None:
    logger.warning("Order not found: id=%s", order_id)
    raise OrderNotFoundError(f"Order {order_id} not found")

# External service unavailable
if self.s3_client is None:
    logger.warning("S3 client not configured — file upload skipped")
    raise OrderFileUploadError("File storage is not configured")
```

## SQLAlchemy Query Builder — always, never session.add()

```python
# SELECT
result = await self.session.execute(select(OrderModel).where(OrderModel.id == order_id))
order = result.scalar_one_or_none()

# INSERT → returns populated ORM instance
result = await self.session.execute(
    insert(OrderModel)
    .values(id=uuid.uuid4(), title=request.title, status=OrderStatus.NEW)
    .returning(OrderModel)
)
order = result.scalar_one()
await self.session.commit()

# UPDATE
await self.session.execute(
    update(OrderModel).where(OrderModel.id == order_id).values(status=OrderStatus.DONE)
)
await self.session.commit()

# DELETE
await self.session.execute(delete(OrderModel).where(OrderModel.id == order_id))
await self.session.commit()

# ❌ Never
self.session.add(order)        # ORM add
session.refresh(order)         # ORM refresh
text("SELECT * FROM orders")   # raw SQL
```

## S3 Upload Pattern (Kafka-based)

```python
# 1. Validate content type via class attribute
if content_type not in self.ALLOWED_CONTENT_TYPES:
    raise HTTPException(status_code=415, detail=f"Unsupported: {content_type}")
if len(payload) > self.MAX_FILE_SIZE:
    raise HTTPException(status_code=413, detail="File too large")

# 2. Check parent exists
result = await self.session.execute(select(ParentModel).where(ParentModel.id == parent_id))
if result.scalar_one_or_none() is None:
    logger.warning("Parent not found: id=%s", parent_id)
    raise ParentNotFoundError(...)

# 3. INSERT with PENDING status
s3_key = FileModel.generate_s3_key(parent_id, filename)
result = await self.session.execute(
    insert(FileModel)
    .values(id=uuid.uuid4(), s3_file_key=s3_key, status=FileStatus.PENDING, ...)
    .returning(FileModel)
)
file_record = result.scalar_one()
await self.session.commit()

# 4. Publish to Kafka — consumer uploads to S3
await publish_s3_upload(self.kafka_producer, StorageTopics.MY_UPLOAD, key=s3_key, body=payload, ...)

return FileDTO.model_validate(file_record)  # status=PENDING
```
